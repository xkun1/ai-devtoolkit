# ─── devtoolkit 环境变量配置 ───
# 复制为 .env 并填入你的 API Key

# DeepSeek（默认模型，性价比最高）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key

# 火山方舟 Ark (Doubao)
# ARK_API_KEY=your-ark-key

# 本地模型真实名称（也可用 CLI --local-model）
# OLLAMA_MODEL=qwen2.5:7b
# LMSTUDIO_MODEL=your-model-name
# LOCAL_MODEL_NAME=generic-local-model

# 仅受管透明代理把公网 DNS 映射到 198.18.0.0/15 时按需开启
# 默认不要设置，避免放宽 SSRF 地址边界
# DEVTOOLKIT_ALLOW_PROXY_MAPPED_IP=1
