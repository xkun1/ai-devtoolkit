{
  "name": "ai-devtoolkit",
  "version": "0.9.0",
  "description": "🛠️ 开发者工具箱：AI 技能包生成 · 代码搜索 · 环境迁移（Cursor / Codex / Claude）",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.mjs",
      "require": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "devtoolkit": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "README.md",
    "README.en.md",
    ".env.example",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "generate:ui": "node scripts/embed-ui.cjs",
    "check:ui": "node scripts/embed-ui.cjs --check",
    "prebuild": "npm run generate:ui",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node bin/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src/ test/ e2e/ \"*.config.{ts,mts}\"",
    "lint:fix": "eslint src/ test/ e2e/ \"*.config.{ts,mts}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html}\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.cjs\" \".github/**/*.yml\" \"*.{js,mjs,json,ts,mts}\" && npm run generate:ui",
    "format:check": "npm run check:ui && prettier --check \"src/**/*.{ts,html}\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.cjs\" \".github/**/*.yml\" \"*.{mjs,ts,mts}\"",
    "prepublishOnly": "npm run check:ui && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:coverage && npm run test:e2e && npm run test:package",
    "test:package": "node scripts/package-smoke.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "cursor",
    "codex",
    "claude",
    "rag",
    "skill",
    "agent",
    "docs",
    "pdf",
    "automation",
    "developer-tools",
    "llm"
  ],
  "author": "kun",
  "license": "MIT",
  "homepage": "https://github.com/xkun1/ai-devtoolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkun1/ai-devtoolkit.git"
  },
  "bugs": {
    "url": "https://github.com/xkun1/ai-devtoolkit/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "pdf-parse": "^1.1.1",
    "turndown": "^7.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.10.0",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsup": "^8.0.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
